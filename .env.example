# Salin menjadi .env.local lalu isi nilainya:
#   cp .env.example .env.local
#
# Database lokal (Docker):
#   docker run -d --name fp-pg -p 55432:5432 \
#     -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=foto_pelantikan postgres:16
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/foto_pelantikan"

# Hex acak minimal 32 karakter. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="ganti-dengan-hex-acak-minimal-32-karakter"

# Opsional: login Google (kosongkan untuk sembunyikan tombolnya)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Wajib di produksi untuk cron pembersihan; kosongkan = endpoint mati (503)
# CRON_SECRET=""

# Opsional: kunci setup admin pertama (lihat README bagian Instalasi pertama)
# SETUP_KEY=""

# Token Vercel Blob (otomatis terisi saat Blob di-connect di Vercel)
# BLOB_READ_WRITE_TOKEN=""
